<!--Aux Shields-->
<FTL>
<systemBlueprint name="oe_aux_shields">
	<type>oe_aux_shields</type>
	<title>Auxiliary Shields</title>
	<desc>Passively Generates super shield layers every 8 seconds, can be boosted to temporarily charge layers every 0.5 seconds before going on cooldown. [Level 3 is installed in the storage menu]</desc>
	<startPower>1</startPower>
	<maxPower>3</maxPower>
	<rarity>1</rarity>
	<upgradeCost>
		<level>40</level>
		<level>9999</level>
		<level>80</level>
		<level>100</level>
	</upgradeCost>
	<cost>125</cost>
</systemBlueprint>

<augBlueprint name="UPG_OE_AUX_SHIELD_CAPACITY">
	<title>Shield Capacitors</title>
	<desc>YOU SHOULD NEVER SEE THIS</desc>
	<cost>0</cost>
	<rarity>0</rarity>
	<stackable>false</stackable>
</augBlueprint>
<augBlueprint name="EX_OE_AUX_SHIELD_CAPACITY">
	<title>Shield Capacitors [X]</title>
	<desc>Removes the layer cap on the Auxiliary Shields system, allowing it to charge up to your super shield cap, or 5, whichever is higher.
		
	[X] - As an external system upgrade, this augment will provide its normal effect but take up an augment slot. Can be converted for free to the internal version under the internal upgrade menu if you have the Cloaking system.</desc>
	<cost>60</cost>
	<rarity>0</rarity>
	<stackable>false</stackable>
</augBlueprint>

<augBlueprint name="UPG_OE_AUX_SHIELD_OVERCHARGER">
	<title>Auxiliary Overcharger</title>
	<desc>YOU SHOULD NEVER SEE THIS</desc>
	<cost>0</cost>
	<rarity>0</rarity>
	<stackable>false</stackable>
</augBlueprint>
<augBlueprint name="EX_OE_AUX_SHIELD_OVERCHARGER">
	<title>Auxiliary Overcharger [X]</title>
	<desc>YOU SHOULD NEVER SEE THIS</desc>
	<cost>0</cost>
	<rarity>0</rarity>
	<stackable>false</stackable>
</augBlueprint>

<augBlueprint name="UPG_OE_AUX_SHIELD_LINKER">
	<title>Computer Synchronisation</title>
	<desc>YOU SHOULD NEVER SEE THIS</desc>
	<cost>0</cost>
	<rarity>0</rarity>
	<stackable>false</stackable>
</augBlueprint>
<augBlueprint name="EX_OE_AUX_SHIELD_LINKER">
	<title>Computer Synchronisation [X]</title>
	<desc>Manning in Auxiliary Shields also provides Shields with 50% of the bonus, Manning in Shields provides Auxiliary Shields with 50% of it's bonus.
    
		[X] - As an external system upgrade, this augment will provide its normal effect but take up an augment slot. Can be converted for free to the internal version under the internal upgrade menu, in the On-board Tech category.</desc>
	<cost>0</cost>
	<rarity>0</rarity>
	<stackable>false</stackable>
</augBlueprint>

<augBlueprint name="BOON_OE_AUX_SHIELDS">
	<title>Aux Shields boon</title>
	<desc>YOU SHOULD NEVER SEE THIS</desc>
	<cost>0</cost>
	<rarity>0</rarity>
	<stackable>false</stackable>
</augBlueprint>
</FTL>

