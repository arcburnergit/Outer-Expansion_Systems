<event name="STORAGE_CHECK_SYSTEM_OE_GREASE_IGNITER">
	<text>You are about to install the Pre-Ignited Canisters upgrade.
	[Effects: System charges are refilled with each jump.]</text>
	<choice max_group="0" blue="false" hidden="true">
		<text>Perform the upgrade. [Cost: 60~]</text>
		<event>
			<text>You install the upgrade.</text>
			<item_modify>
				<item type="scrap" min="-60" max="-60" />
			</item_modify>
			<choice hidden="true">
				<text>Continue...</text>
				<event load="INSTALL_OE_GREASE_IGNITER" />
			</choice>
		</event>
	</choice> 
	<choice req="EX_OE_GREASE_IGNITER" max_group="1" blue="false" hidden="true">
		<text>Install the External Augment internally.</text>
		<event>
			<text>You install the upgrade.</text>
			<remove name="EX_OE_GREASE_IGNITER" />
			<choice hidden="true">
				<text>Continue...</text>
				<event load="INSTALL_OE_GREASE_IGNITER" />
			</choice>
		</event>
	</choice>
	<choice req="pilot" lvl="1" max_group="2" blue="false" hidden="true">
		<text>Nevermind.</text>
		<event load="STORAGE_CHECK_SYSTEM_LOAD" />
	</choice>
</event>
<event name="INSTALL_OE_GREASE_IGNITER">
	<variable name="loc_internal_upgrades" op="add" val="1" />
	<hiddenAug>UPG_OE_GREASE_IGNITER</hiddenAug>
	<loadEvent>STORAGE_CHECK_SYSTEM</loadEvent>
</event>

<event name="STORAGE_CHECK_SYSTEM_OE_GREASE_SWITCH">
	<text>You are about to install the Fluid Recycler upgrade.
	[Effects: Switching enhancements no longer resets system charges.]</text>
	<choice max_group="0" blue="false" hidden="true">
		<text>Perform the upgrade. [Cost: 20~, 5{]</text>
		<event>
			<text>You install the upgrade.</text>
			<item_modify>
				<item type="fuel" min="-5" max="-5" />
				<item type="scrap" min="-20" max="-20" />
			</item_modify>
			<choice hidden="true">
				<text>Continue...</text>
				<event load="INSTALL_OE_GREASE_SWITCH" />
			</choice>
		</event>
	</choice> 
	<choice req="EX_OE_GREASE_SWITCH" max_group="1" blue="false" hidden="true">
		<text>Install the External Augment internally.</text>
		<event>
			<text>You install the upgrade.</text>
			<remove name="EX_OE_GREASE_SWITCH" />
			<choice hidden="true">
				<text>Continue...</text>
				<event load="INSTALL_OE_GREASE_SWITCH" />
			</choice>
		</event>
	</choice>
	<choice req="pilot" lvl="1" max_group="2" blue="false" hidden="true">
		<text>Nevermind.</text>
		<event load="STORAGE_CHECK_SYSTEM_LOAD" />
	</choice>
</event>
<event name="INSTALL_OE_GREASE_SWITCH">
	<variable name="loc_internal_upgrades" op="add" val="1" />
	<hiddenAug>UPG_OE_GREASE_SWITCH</hiddenAug>
	<loadEvent>STORAGE_CHECK_SYSTEM</loadEvent>
</event>
</FTL>