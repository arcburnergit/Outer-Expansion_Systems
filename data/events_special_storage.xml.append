<?xml version="1.0" encoding="UTF-8"?>
<FTL>
<mod:findName type="event" name="STORAGE_CHECK_SYSTEM">
	<mod-append:choice req="oe_aux_shields" blue="false" hidden="true">
	  <text>Auxiliary Shields.</text>
	  <event load="STORAGE_CHECK_SYSTEM_OE_AUX_SHIELDS" />
	</mod-append:choice>
	<mod-append:choice req="oe_grease" blue="false" hidden="true">
	  <text>Weapons Amplifier.</text>
	  <event load="STORAGE_CHECK_SYSTEM_OE_GREASE" />
	</mod-append:choice>
	<mod-append:choice req="oe_growth" blue="false" hidden="true">
	  <text>Life Bloom.</text>
	  <event load="STORAGE_CHECK_SYSTEM_OE_GROWTH" />
	</mod-append:choice>
</mod:findName>
</FTL>

<!--Aux Shields-->
<FTL>
<event name="STORAGE_CHECK_SYSTEM_OE_AUX_SHIELDS">
    <text>What upgrade do you want to install?</text>
    <choice req="oe_aux_shields" lvl="0" max_lvl="1" max_group="0" blue="false" hidden="true">
        <text>Level 3 Auxiliary Shields. [UNAVAILABLE: system is not level 2]</text>
        <event load="OPTION_INVALID"/>
    </choice>
    <choice req="oe_aux_shields" lvl="2" max_group="0" blue="false" hidden="true">
        <text>Level 3 Auxiliary Shields. [Cost: 65~, 3{, 1|]</text>
        <event load="STORAGE_CHECK_SYSTEM_OE_AUX_SHIELDS_LEVEL3"/>
    </choice>
	<choice req="oe_aux_shields" lvl="3" max_group="0" blue="false" hidden="true">
        <text>Level 3 Auxiliary Shields. [ALREADY INSTALLED]</text>
        <event load="OPTION_INVALID"/>
    </choice>
    <choice req="UPG_OE_AUX_SHIELD_CAPACITY" lvl="1" max_group="1" blue="false" hidden="true">
        <text>Shield Capacitors. [ALREADY INSTALLED]</text>
        <event load="OPTION_INVALID"/>
    </choice>
    <choice req="UPG_OE_AUX_SHIELD_CAPACITY" lvl="0" max_group="1" blue="false" hidden="true">
        <text>Shield Capacitors. [Cost: 55~, 2{, 4}]</text>
        <event load="STORAGE_CHECK_SYSTEM_OE_AUX_SHIELD_CAPACITY"/>
    </choice>
    <choice req="UPG_OE_AUX_SHIELD_OVERCHARGER" lvl="1" max_group="2" blue="false" hidden="true">
        <text>Auxiliary Overcharger. [ALREADY INSTALLED]</text>
        <event load="OPTION_INVALID" />
    </choice>
    <choice req="UPG_OE_AUX_SHIELD_OVERCHARGER" lvl="0" max_group="2" blue="false" hidden="true">
        <text>Auxiliary Overcharger. [Cost: 50~, 1{]</text>
        <event load="STORAGE_CHECK_SYSTEM_OE_AUX_SHIELD_OVERCHARGER" />
    </choice>
    <choice req="UPG_OE_AUX_SHIELD_LINKER" lvl="1" max_group="3" blue="false" hidden="true">
        <text>Computer Synchronisation. [ALREADY INSTALLED]</text>
        <event load="OPTION_INVALID" />
    </choice>
    <choice req="UPG_OE_AUX_SHIELD_LINKER" lvl="0" max_group="3" blue="false" hidden="true">
        <text>Computer Synchronisation. [Cost: 35~, 5|]</text>
        <event load="STORAGE_CHECK_SYSTEM_OE_AUX_SHIELD_LINKER" />
    </choice>
    <choice>
        <text>Nevermind.</text>
        <event load="STORAGE_CHECK_SYSTEM_LOAD" />
    </choice>
</event>
<event name="STORAGE_CHECK_SYSTEM_OE_AUX_SHIELDS_LEVEL3">
	<text>You are about to upgrade the Auxiliary Shields to level 3.
	[Effects: 15 second boost, is not compatible with Shield Capacitors]</text>
	<choice req="UPG_OE_AUX_SHIELD_CAPACITY" lvl="0" max_group="0" blue="false" hidden="true">
		<text>Perform the upgrade. [Cost: 65~, 3{, 1|]</text>
		<event>
			<text>You install the upgrade.</text>
			<upgrade amount="1" system="oe_aux_shields"/>
			<item_modify>
				<item type="fuel" min="-3" max="-3"/>
				<item type="drones" min="-1" max="-1"/>
				<item type="scrap" min="-65" max="-65"/>
			</item_modify>
			<choice>
				<text>Continue...</text>
				<event load="STORAGE_CHECK_SYSTEM_LOAD"/>
			</choice>
		</event>
	</choice>
	<choice req="UPG_OE_AUX_SHIELD_CAPACITY" lvl="1" max_group="0" blue="false" hidden="true">
		<text>This upgrade is unavailable: not compatible with Shield Capacitors.</text>
		<event load="OPTION_INVALID"/>
	</choice>
	<choice req="pilot" lvl="1" max_group="1" blue="false" hidden="true">
		<text>Nevermind.</text>
		<event load="STORAGE_CHECK_SYSTEM_LOAD"/>
	</choice>
</event>

<event name="STORAGE_CHECK_SYSTEM_OE_AUX_SHIELD_CAPACITY">
	<text>You are about to install the Shield Capacitors upgrade.
	[Effects: Removes the layer cap on the Auxiliary Shields system, allowing it to charge up to your super shield cap, or 5, whichever is higher, is not compatible with Auxiliary Shields lvl 3]</text>
	<choice req="oe_aux_shields" lvl="1" max_group="0" blue="false" hidden="true">
		<text>Perform the upgrade. [Cost: 55~, 4}, 2{]</text>
		<event>
			<text>You install the upgrade.</text>
			<item_modify>
				<item type="missiles" min="-4" max="-4"/>
				<item type="fuel" min="-2" max="-2"/>
				<item type="scrap" min="-55" max="-55"/>
			</item_modify>
			<choice hidden="true">
				<text>Continue...</text>
				<event load="INSTALL_OE_AUX_SHIELD_CAPACITY"/>
			</choice>
		</event>
	</choice>
	<choice req="oe_aux_shields" lvl="3" max_group="0" blue="false" hidden="true">
		<text>This upgrade is unavailable: not compatible with Auxiliary Shields Level 3.</text>
		<event load="OPTION_INVALID"/>
	</choice>
	<choice req="EX_OE_AUX_SHIELD_CAPACITY" max_group="1" blue="false" hidden="true">
		<text>Install the External Augment internally.</text>
		<event>
			<text>You install the upgrade.</text>
			<remove name="EX_OE_AUX_SHIELD_CAPACITY"/>
			<choice hidden="true">
				<text>Continue...</text>
				<event load="INSTALL_OE_AUX_SHIELD_CAPACITY"/>
			</choice>
		</event>
	</choice>
	<choice req="pilot" lvl="1" max_group="2" blue="false" hidden="true">
		<text>Nevermind.</text>
		<event load="STORAGE_CHECK_SYSTEM_LOAD"/>
	</choice>
</event>
<event name="INSTALL_OE_AUX_SHIELD_CAPACITY">
	<variable name="loc_internal_upgrades" op="add" val="1"/>
	<hiddenAug>UPG_OE_AUX_SHIELD_CAPACITY</hiddenAug>
	<loadEvent>STORAGE_CHECK_SYSTEM</loadEvent>
</event>

<event name="STORAGE_CHECK_SYSTEM_OE_AUX_SHIELD_LINKER">
	<text>You are about to install the Computer Synchronisation upgrade.
	[Effects: Manning in Auxiliary Shields also provides Shields with 50% of the bonus, Manning in Shields provides Auxiliary Shields with 50% of it's bonus.]</text>
	<choice max_group="0" blue="false" hidden="true">
		<text>Perform the upgrade. [Cost: 35~, 5|]</text>
		<event>
			<text>You install the upgrade.</text>
			<item_modify>
				<item type="drones" min="-5" max="-5" />
				<item type="scrap" min="-35" max="-35" />
			</item_modify>
			<choice hidden="true">
				<text>Continue...</text>
				<event load="INSTALL_OE_AUX_SHIELD_LINKER" />
			</choice>
		</event>
	</choice> 
	<choice req="EX_OE_AUX_SHIELD_LINKER" max_group="1" blue="false" hidden="true">
		<text>Install the External Augment internally.</text>
		<event>
			<text>You install the upgrade.</text>
			<remove name="EX_OE_AUX_SHIELD_LINKER" />
			<choice hidden="true">
				<text>Continue...</text>
				<event load="INSTALL_OE_AUX_SHIELD_LINKER" />
			</choice>
		</event>
	</choice>
	<choice req="pilot" lvl="1" max_group="2" blue="false" hidden="true">
		<text>Nevermind.</text>
		<event load="STORAGE_CHECK_SYSTEM_LOAD" />
	</choice>
</event>
<event name="INSTALL_OE_AUX_SHIELD_LINKER">
	<variable name="loc_internal_upgrades" op="add" val="1" />
	<hiddenAug>UPG_OE_AUX_SHIELD_LINKER</hiddenAug>
	<loadEvent>STORAGE_CHECK_SYSTEM</loadEvent>
</event>

<event name="STORAGE_CHECK_SYSTEM_OE_AUX_SHIELD_OVERCHARGER">
	<text>You are about to install the Auxiliary Overcharger upgrade.
	[Effects: Grants all super shield layers that the system can generate on jump.]</text>
	<choice max_group="0" blue="false" hidden="true">
		<text>Perform the upgrade. [Cost: 50~, 1{]</text>
		<event>
			<text>You install the upgrade.</text>
			<item_modify>
				<item type="fuel" min="-1" max="-1" />
				<item type="scrap" min="-50" max="-50" />
			</item_modify>
			<choice hidden="true">
				<text>Continue...</text>
				<event load="INSTALL_OE_AUX_SHIELD_OVERCHARGER" />
			</choice>
		</event>
	</choice> 
	<choice req="EX_OE_AUX_SHIELD_OVERCHARGER" max_group="1" blue="false" hidden="true">
		<text>Install the External Augment internally.</text>
		<event>
			<text>You install the upgrade.</text>
			<remove name="EX_OE_AUX_SHIELD_OVERCHARGER" />
			<choice hidden="true">
				<text>Continue...</text>
				<event load="INSTALL_OE_AUX_SHIELD_OVERCHARGER" />
			</choice>
		</event>
	</choice>
	<choice req="pilot" lvl="1" max_group="2" blue="false" hidden="true">
		<text>Nevermind.</text>
		<event load="STORAGE_CHECK_SYSTEM_LOAD" />
	</choice>
</event>
<event name="INSTALL_OE_AUX_SHIELD_OVERCHARGER">
	<variable name="loc_internal_upgrades" op="add" val="1" />
	<hiddenAug>UPG_OE_AUX_SHIELD_OVERCHARGER</hiddenAug>
	<loadEvent>STORAGE_CHECK_SYSTEM</loadEvent>
</event>
</FTL>

<!--Grease-->
<FTL>

