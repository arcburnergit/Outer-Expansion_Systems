	</choice>
	<choice req="OE_GREASE_EFFECT_CASCADE" lvl="1" max_group="11" blue="false" hidden="true">
		<text>Cascade Amplification. [ALREADY AVAILABLE]</text>
		<event load="OPTION_INVALID"/>
