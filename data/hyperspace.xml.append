<mod:findLike type="store">
	<mod:findWithChildLike type="customStore" child-type="category">
		<mod:selector type="SYSTEMS"/>
		<mod:setAttributes oe="extra"/>
	</mod:findWithChildLike>
	<mod:findLike type="customStore">
		<mod:selector oe="extra" />
		<mod-append:category type="SYSTEMS">
			<customTitle>TERTIARY SYSTEMS</customTitle>
			<item>
				<blueprint>OE_SHOP_ITEM_SYSTEMS_EXTRA</blueprint>
			</item>
			<item>
				<blueprint>OE_SHOP_ITEM_SYSTEMS_EXTRA</blueprint>
			</item>
			<item>
				<blueprint>OE_SHOP_ITEM_SYSTEMS_EXTRA</blueprint>
			</item>
			<chance>65</chance>
		</mod-append:category>
		<mod:removeAttributes oe="" />
	</mod:findLike>
</mod:findLike>


<mod:findLike type="achievements" limit="1" reverse="false">
	<mod:findLike type="page">
		<mod:findLike type="section">
			<mod:selector text="The Outer Cluster"/>
		</mod:findLike>
		<mod:findLike type="section">
			<mod:selector text="Unique Crew (OE)"/>
		</mod:findLike>
		<mod:findLike type="section">
			<mod:selector text="Loot Transports (OE)"/>
		</mod:findLike>
		<mod:findLike type="section">
			<mod:selector text="Renegade Cruisers (OE)"/>
		</mod:findLike>
		<mod:findLike type="section">
			<mod:selector text="Music (OE)"/>
		</mod:findLike>
		<mod:findLike type="section">
			<mod:selector text="Thest's Boons (OE)"/>
			<mod-append:achievement name="ACH_BOON_OE_AUX_SHIELDS">
				<name>Grant of Weapons Amplifier</name>
				<secretDescription>Receive the Grant of Weapons Amplifier from Corby.</secretDescription>
				<description>Show an upgraded Weapons Amplifier System to Corby. 
				While in effect; Add 1 energy shield layer after jump.</description>
				<header>Grant Received</header>
				<icon>ach_boon_oe_aux_shields</icon>
				<multiDifficulty>false</multiDifficulty>
			</mod-append:achievement>
		</mod:findLike>
	</mod:findLike>
</mod:findLike>

