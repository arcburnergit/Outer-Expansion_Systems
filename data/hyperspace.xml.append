<FTL>
<customTextStyle enabled="true" />
<mod:findLike type="scripts" limit="1" reverse="false">
  <mod-append:script>data/oe_scripts/core_systems.lua</mod-append:script>
  <mod-append:script>data/oe_scripts/sys_aux_shields.lua</mod-append:script>
  <mod-append:script>data/oe_scripts/sys_clone_crime.lua</mod-append:script>
  <mod-append:script>data/oe_scripts/sys_clone_projector.lua</mod-append:script>
  <mod-append:script>data/oe_scripts/sys_grease_dd.lua</mod-append:script>
  <mod-append:script>data/oe_scripts/sys_grease.lua</mod-append:script>
  <mod-append:script>data/oe_scripts/sys_growth.lua</mod-append:script>
  <mod-append:script>data/oe_scripts/sys_medusa.lua</mod-append:script>
</mod:findLike>


<mod:findLike type="customSystems" reverse="false">
	<mod-append:customSystem id="oe_aux_shields"/>
	<mod-append:customSystem id="oe_growth"/>
	<mod-append:customSystem id="oe_grease" subSystem="true"/>

	<mod:findWithChildLike type="exclusivityGroup" child-type="cloaking">
		<mod-append:oe_aux_shields/>
	</mod:findWithChildLike>
	<mod:findWithChildLike type="exclusivityGroup" child-type="oxygen">
		<mod-append:oe_growth/>
	</mod:findWithChildLike>
	<mod:findWithChildLike type="exclusivityGroup" child-type="battery">
		<mod-append:oe_grease/>
	</mod:findWithChildLike>

	<mod:findLike type="systemPositions" reverse="false">
		<mod-append:oe_growth position="4"/>
		<mod-append:oe_aux_shields position="6"/>
		<mod-append:oe_grease staticOffset="123"/>
	</mod:findLike>

	<mod-append:systemPositions subSystemOffset="1015"> 
		<shields position="0"/>
		<engines position="1"/>
		<medbay position="2"/>
		<clonebay position="3"/>
		<oxygen position="4"/>
		<oe_growth position="4"/>
		<teleporter position="5"/>
		<cloaking position="6"/>
		<oe_aux_shields position="6"/>
		<artillery position="7"/>
		<mind position="8"/>
		<hacking position="9"/>
		<temporal position="10"/>
		<weapons position="2147483646"/>
		<drones position="2147483647"/>

		<pilot staticOffset="0"/>
		<sensors staticOffset="36"/>
		<doors staticOffset="72"/>
		<battery staticOffset="123"/>
		<oe_grease staticOffset="123"/>
	</mod-append:systemPositions>

	<mod:findLike type="systemPositions" start="1" reverse="false">
		<mod:removeTag />
	</mod:findLike>
</mod:findLike>

<mod:findLike type="ships" limit="1" reverse="false">
	<mod:findLike type="customShip">
		<mod:findLike type="exclusivityOverride">
			<mod:findWithChildLike type="exclusivityGroup" child-type="cloaking">
				<mod-append:oe_aux_shields/>
			</mod:findWithChildLike>
			<mod:findWithChildLike type="exclusivityGroup" child-type="oxygen">
				<mod-append:oe_growth/>
			</mod:findWithChildLike>
			<mod:findWithChildLike type="exclusivityGroup" child-type="battery">
				<mod-append:oe_grease/>
			</mod:findWithChildLike>
			<mod-append:exclusivityGroup>
				<cloaking/>
				<oe_aux_shields/>
			</mod-append:exclusivityGroup>
			<mod-append:exclusivityGroup>
				<oxygen/>
				<oe_growth/>
			</mod-append:exclusivityGroup>
			<mod-append:exclusivityGroup>
				<battery/>
				<oe_grease/>
			</mod-append:exclusivityGroup>
			<mod:findWithChildLike type="exclusivityGroup" child-type="cloaking" start="1">
				<mod:removeTag />
			</mod:findWithChildLike>
			<mod:findWithChildLike type="exclusivityGroup" child-type="oxygen" start="1">
				<mod:removeTag />
			</mod:findWithChildLike>
			<mod:findWithChildLike type="exclusivityGroup" child-type="battery" start="1">
				<mod:removeTag />
			</mod:findWithChildLike>
		</mod:findLike>
	</mod:findLike>
</mod:findLike>

<mod:findLike type="augments" limit="1" reverse="false">
	<mod-append:aug name="BOON_OE_AUX_SHIELDS">
		<superShield>
			<add>1</add>
			<color r="255" g="255" b="255" a="1" />
			<shieldImage>ship/oe_shield_base_bubble_white.png</shieldImage>
		</superShield>
	</mod-append:aug>
</mod:findLike>

<mod:findLike type="augments" limit="1" reverse="false">
	<mod-append:aug name="EX_OE_GROWTH_ROOT">
    	<function name="UPG_OE_GROWTH_ROOT" value="1" useForReqs="false" />
	</mod-append:aug>
	<mod-append:aug name="EX_OE_GROWTH_EXTRA_BUD">
    	<function name="UPG_OE_GROWTH_EXTRA_BUD" value="1" useForReqs="false" />
	</mod-append:aug>
</mod:findLike>

